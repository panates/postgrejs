{
  "extends": "./tsconfig-base.json",
  "include": [
    "./packages/*/test/**/*.*",
    "./packages/*/src/**/*.*",
    "./packages/*/benchmark/**/*.ts",
    "./support/*.d.mts"
  ],
  "compilerOptions": {
    "types": ["node", "mocha"],
    "noEmit": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "postgrejs": ["./packages/postgrejs/src/index.js"],
      "postgrejs-otel": ["./packages/otel/src/index.js"]
    }
  }
}
