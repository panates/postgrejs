{
  "name": "postgrejs",
  "description": "Professional PostgreSQL client NodeJS",
  "version": "3.15.0",
  "author": "Panates",
  "license": "BSD-3-Clause",
  "private": true,
  "homepage": "https://www.postgrejs.com/",
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>",
    "Ilker Gurelli <i.gurelli@panates.com>",
    "Onur Tokel <o.tokel@panates.com>",
    "Bircan Yuruk <b.yuruk@panates.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panates/postgrejs.git"
  },
  "scripts": {
    "bench": "node --import ./benchmark/env.mjs --import @swc-node/register/esm-register benchmark/cli.ts",
    "bench:bun": "bun run --import ./benchmark/env.mjs benchmark/cli.ts",
    "bench:report": "node --import ./benchmark/env.mjs --import @swc-node/register/esm-register benchmark/report/render-markdown.ts"
  },
  "dependencies": {
    "@jsopen/objects": "^2.3.4",
    "doublylinked": "^2.5.6",
    "flexy-buffer": "^1.1.2",
    "lightning-pool": "^4.14.2",
    "power-tasks": "^1.14.2",
    "putil-promisify": "^1.10.1",
    "putil-varhelpers": "^1.7.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "bun-types": "^1.4.4",
    "dotenv": "^18.0.10",
    "expect": "^30.5.2",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "postgres": "^4.1.0",
    "temporal-polyfill": "^1.0.8",
    "tinybench": "^6.2.3",
    "yargs": "^18.2.0"
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.0"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "postgre",
    "pg",
    "database",
    "db",
    "driver",
    "client",
    "backend",
    "rdbms",
    "sql",
    "typescript",
    "wire-protocol",
    "no-native-bindings",
    "cursor",
    "server-side-cursor",
    "logical-replication",
    "copy",
    "connection-pool",
    "prepared-statements",
    "bun",
    "bunjs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
