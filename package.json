{
  "name": "postgrejs-repo",
  "private": true,
  "version": "3.15.1",
  "license": "BSD-3-Clause",
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>",
    "Ilker Gurelli <i.gurelli@panates.com>",
    "Onur Tokel <o.tokel@panates.com>",
    "Bircan Yuruk <b.yuruk@panates.com>"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panates/postgrejs.git"
  },
  "homepage": "https://www.postgrejs.com/",
  "scripts": {
    "build": "rman build",
    "typecheck": "tsc -b packages/postgrejs/tsconfig-build.json packages/otel/tsconfig-build.json --noEmit && tsc -p tsconfig-test.json",
    "test": "mocha",
    "precover": "rman clean",
    "precitest": "rman clean",
    "citest": "c8 mocha",
    "lint": "rman lint",
    "check": "rman check",
    "format": "rman format",
    "bench": "pnpm --filter postgrejs run bench",
    "bench:bun": "pnpm --filter postgrejs run bench:bun",
    "bench:report": "pnpm --filter postgrejs run bench:report",
    "graph": "graphify update .",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@panates/eslint-config": "^2.3.5",
    "@panates/eslint-config-ts": "^2.3.5",
    "@panates/rman-preset": "^2.2.2",
    "@panates/tsconfig": "^2.1.8",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@swc/helpers": "^0.5.24",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "dpdm": "^4.3.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "mocha": "^12.0.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0"
  },
  "packageManager": "pnpm@12.10.1"
}
