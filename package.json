    "power-tasks": "^1.14.2",
    "putil-promisify": "^1.10.1",
    "putil-varhelpers": "^1.7.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@panates/eslint-config": "^2.2.0",
    "@panates/eslint-config-ts": "^2.2.1",
    "@panates/rman-preset": "^1.8.3",
    "@panates/tsconfig": "^2.1.7",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@swc/helpers": "^0.5.23",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "bun-types": "^1.4.2",
    "c8": "^12.0.0",
    "dotenv": "^18.0.5",
    "dpdm": "^4.3.0",
    "expect": "^30.5.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "mocha": "^12.0.3",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "postgres": "^3.4.9",
    "temporal-polyfill": "^1.0.5",
    "tinybench": "^6.2.0",
    "typescript": "^6.0.3",
    "yargs": "^18.2.0"
  },
  "scripts": {
    "bench": "node --import ./benchmark/env.mjs --import @swc-node/register/esm-register benchmark/cli.ts",
    "bench:bun": "bun run --import ./benchmark/env.mjs benchmark/cli.ts",
    "bench:report": "node --import ./benchmark/env.mjs --import @swc-node/register/esm-register benchmark/report/render-markdown.ts",
    "typecheck": "tsc -b tsconfig-build.json --noEmit",
    "precover": "rman clean",
    "test": "mocha",
    "precitest": "rman clean",
    "citest": "c8 mocha",
    "graph": "graphify update .",
    "prepare": "husky || true"
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0"
  },
  "homepage": "https://www.postgrejs.com/",
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>",
    "Ilker Gurelli <i.gurelli@panates.com>",
