{
  "name": "postgrejs",
  "description": "Professional PostgreSQL client NodeJS",
  "version": "3.10.1",
  "author": "Panates",
  "license": "BSD-3-Clause",
  "private": true,
  "dependencies": {
    "@jsopen/objects": "^2.2.3",
    "doublylinked": "^2.5.6",
    "flexy-buffer": "^1.1.0",
    "lightning-pool": "^4.12.0",
    "power-tasks": "^1.14.2",
    "putil-promisify": "^1.10.1",
    "putil-varhelpers": "^1.7.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@panates/eslint-config": "^2.1.6",
    "@panates/eslint-config-ts": "^2.1.6",
    "@panates/tsconfig": "^2.1.6",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.43",
    "@swc/helpers": "^0.5.23",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "auto-changelog": "^2.6.0",
    "bun-types": "^1.4.2",
    "c8": "^12.0.0",
    "dotenv": "^18.0.3",
    "dpdm": "^4.2.0",
    "expect": "^30.4.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "mocha": "^12.0.1",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "temporal-polyfill": "^1.0.5",
    "tinybench": "^6.2.0",
    "ts-cleanup": "^1.3.0",
    "typescript": "^6.0.3",
    "yargs": "^18.1.0"
  },
  "scripts": {
    "compile": "tsc -b tsconfig-build.json --noEmit",
    "clean": "npm run clean:src && npm run clean:dist",
    "clean:dist": "rimraf build coverage",
    "clean:src": "ts-cleanup -s src --all | ts-cleanup -s test",
    "prebuild": "npm run check && npm run clean:dist && npm run lint",
    "build": "tsc -b tsconfig-build.json",
    "postbuild": "node postbuild.cjs && rimraf build/*.tsbuildinfo",
    "_postbuild": "npm run postbuild:copyfiles && node postbuild.cjs",
    "_postbuild:copyfiles": "cp LICENSE README.md CHANGELOG.md ./build && cp ./support/package.esm.json ./build/esm/package.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "bench": "node --import ./benchmark/env.mjs --import @swc-node/register/esm-register benchmark/cli.ts",
    "bench:bun": "bun run --import ./benchmark/env.mjs benchmark/cli.ts",
    "bench:report": "node --import ./benchmark/env.mjs --import @swc-node/register/esm-register benchmark/report/render-markdown.ts",
    "format": "prettier . --write --log-level=warn",
    "precover": "rimraf coverage",
    "check": "dpdm -T --no-warning --no-tree ./src/index.ts",
    "test": "mocha",
    "precitest": "rimraf coverage",
    "citest": "c8 mocha",
    "qc": "npm run lint && npm run check",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "prepare": "husky || true",
    "graph": "graphify update ."
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0"
  },
  "homepage": "https://www.postgrejs.com/",
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>",
    "Ilker Gurelli <i.gurelli@panates.com>",
    "Onur Tokel <o.tokel@panates.com>",
    "Bircan Yuruk <b.yuruk@panates.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/panates/postgrejs.git"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "postgre",
    "pg",
    "database",
    "db",
    "driver",
    "client",
    "backend",
    "rdbms",
    "sql",
    "typescript",
    "wire-protocol",
    "no-native-bindings",
    "cursor",
    "server-side-cursor",
    "logical-replication",
    "copy",
    "connection-pool",
    "prepared-statements",
    "bun",
    "bunjs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
