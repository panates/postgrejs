    "Bircan Yuruk <b.yuruk@panates.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/panates/postgrejs.git"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "postgre",
    "pg",
    "database",
    "db",
    "driver",
    "client",
    "backend",
    "rdbms",
